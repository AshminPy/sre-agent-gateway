{
  "tools": [
    {
      "name": "list_k8s_events",
      "description": "Read Kubernetes events for a namespace, pod, or workload during incident investigation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parent": {
            "type": "string",
            "description": "GKE cluster resource path, for example projects/your-gcp-project-id/locations/us-central1/clusters/sre-test-cluster"
          },
          "namespace": {
            "type": "string",
            "description": "Kubernetes namespace"
          },
          "name": {
            "type": "string",
            "description": "Kubernetes resource name, such as pod name"
          },
          "resourceType": {
            "type": "string",
            "description": "Kubernetes resource type, such as pod"
          }
        },
        "required": ["parent", "namespace"]
      },
      "annotations": {
        "title": "List Kubernetes Events",
        "readOnlyHint": true,
        "idempotentHint": true
      }
    },
