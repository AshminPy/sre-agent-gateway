# Copy this file to .env and fill in your values.
# agent/.env is gitignored because it contains project-specific URLs.
#
# After running Terraform, get values with:
#   terraform -chdir=iac/agent output -raw <name>

# GCP project and region
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Gemini model — gemini-2.5-flash is the default
GEMINI_MODEL=gemini-2.5-flash

# Custom MCP server URL (Cloud Run)
# Get from: terraform -chdir=iac/agent output -raw custom_mcp_url
K8S_MCP_URL=https://sre-k8s-mcp-<hash>.us-central1.run.app

# Google-managed GKE Remote MCP — this URL is fixed, do not change
GKE_REMOTE_MCP_URL=https://container.googleapis.com/mcp/read-only

# Evidence bucket (no gs:// prefix)
# Get from: terraform -chdir=iac/agent output -raw evidence_bucket_name
EVIDENCE_BUCKET=your-gcp-project-id-evidence

# Get from: terraform -chdir=iac/agent output -raw reasoning_engine_resource_name
# Example: projects/123456789/locations/us-central1/reasoningEngines/987654321
# AGENT_RESOURCE_NAME=

# Vertex AI Memory Bank — full resource path of the memory bank agent engine
# Created by Terraform as a separate reasoningEngine resource (no source code)
# The SRE agent reads prior RCAs before each investigation and writes one after.
# SREs review and delete memories via: Agent Platform → sre-agent-memory-bank → Memories tab
# Get from: terraform -chdir=iac/agent output -raw memory_bank_resource_name
# Example: projects/YOUR_PROJECT/locations/us-central1/reasoningEngines/REASONING_ENGINE_ID
MEMORY_BANK_RESOURCE=
