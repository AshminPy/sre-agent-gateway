# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/
.python-version.local

# ── Secrets / local config (NEVER commit) ──────────────────────────────────
# Copy agent/.env.example → agent/.env and fill in your values.
agent/.env
*.env
!*.env.example

# ── Build artifacts ────────────────────────────────────────────────────────
# agent.tar.gz is generated by `make package-agent` at build/plan time.
agent.tar.gz
# A/B candidate archive (openspec/changes/candidate-agent-ab) -- built from source outside this repo, never committed.
agent-candidate.tar.gz
*.zip

# ── Terraform (both stacks) ────────────────────────────────────────────────
# State can contain sensitive values — use the GCS remote backend for teams.
# .terraform.lock.hcl is intentionally NOT excluded (2026-08-10) — HashiCorp's
# own recommendation is to commit it for reproducible provider versions across
# machines/CI; unlike state, it contains no sensitive values, only provider
# source/version/checksum pins.
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfplan
# Copy terraform.tfvars.example → terraform.tfvars and fill in your values.
**/terraform.tfvars
**/*.auto.tfvars
# Keep the documented example files.
!**/terraform.tfvars.example

# ── Local eval output ──────────────────────────────────────────────────────
results/

# ── Tooling / build state (never publish) ──────────────────────────────────
.claude/

# ── Editor / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
ansible/artifacts/
